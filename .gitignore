node_modules/
out/
dist/
.DS_Store
.idea/
*.log
*.tsbuildinfo
.env
.env.*
!.env.example
resources/bin/mihomo*.exe
resources/bin/mihomo*
resources/bin/*/*.zip
!resources/bin/.gitkeep
resources/tun-service/*/tun-service.exe
# Runtime artifacts written next to the service binary by the local TUN evidence
# harness (scripts/tun-runtime-evidence.ps1). service-config.json embeds this
# machine's SID and absolute paths, and state/ is re-ACLed to SYSTEM, so neither
# is ever committable.
resources/tun-service/*/service-config.json
resources/tun-service/*/state/
# Local Go cross-compile output dropped in the module dir by ad-hoc `go build`
# runs (the real packaging path writes resources/tun-service/<arch>/).
native/tun-service/*.exe
