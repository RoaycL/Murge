{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop application brand configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productName",
    "shortName",
    "description",
    "appId",
    "executableName",
    "protocolScheme",
    "defaultProfileName",
    "companyName",
    "repositoryUrl",
    "supportUrl",
    "copyright",
    "legacyProductNames",
    "legacyAppDataNamespaces"
  ],
  "properties": {
    "$schema": { "type": "string", "description": "Path to this schema document." },
    "productName": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "shortName": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "description": { "type": "string" },
    "appId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]+$" },
    "executableName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "protocolScheme": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*$" },
    "defaultProfileName": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "companyName": { "type": "string" },
    "repositoryUrl": { "type": "string" },
    "supportUrl": { "type": "string" },
    "copyright": { "type": "string" },
    "legacyProductNames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Product names a released build has used as its application-data folder. Never derived from productName so a rename cannot orphan historical data."
    },
    "legacyAppDataNamespaces": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Additional app-data namespaces a released build may have written under before the appId namespace was adopted."
    }
  }
}
