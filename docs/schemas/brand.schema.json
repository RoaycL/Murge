{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop application brand configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productName",
    "shortName",
    "description",
    "appId",
    "executableName",
    "protocolScheme",
    "companyName",
    "repositoryUrl",
    "supportUrl",
    "copyright"
  ],
  "properties": {
    "productName": { "type": "string", "minLength": 1 },
    "shortName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "appId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9.-]+$" },
    "executableName": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "protocolScheme": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*$" },
    "companyName": { "type": "string" },
    "repositoryUrl": { "type": "string" },
    "supportUrl": { "type": "string" },
    "copyright": { "type": "string" }
  }
}
