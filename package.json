{
  "name": "proxy-desktop-shell",
  "version": "0.3.1",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Brand-configurable desktop GUI shell for a mihomo-based network client.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run brand:check && npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "brand:check": "node scripts/check-brand.mjs",
    "license:check": "node scripts/check-license.mjs",
    "release-notes:generate": "node scripts/generate-release-notes.mjs",
    "kernel:prepare": "node scripts/prepare-mihomo-assets.mjs",
    "tun-service:test": "cd native/tun-service && go test ./...",
    "tun-service:build": "node scripts/build-tun-service.mjs --all",
    "package:win": "npm run kernel:prepare && npm run tun-service:build && npm run build && electron-builder --win --config electron-builder.config.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vueuse/core": "^13.0.0",
    "electron-updater": "^6.8.9",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
