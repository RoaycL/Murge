{
  "name": "proxy-desktop-shell",
  "version": "0.10.3-beta.8",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Brand-configurable desktop GUI shell for a mihomo-based network client.",
  "scripts": {
    "build": "npm run brand:check && npm run typecheck && npm run build:renderer",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "brand:check": "node scripts/check-brand.mjs",
    "license:check": "node scripts/check-license.mjs",
    "notices:rust": "node scripts/generate-rust-notices.mjs",
    "release-notes:generate": "node scripts/generate-release-notes.mjs",
    "kernel:prepare": "node scripts/prepare-mihomo-assets.mjs",
    "tun-service:test": "cd native/tun-service && go test ./...",
    "tun-service:build": "node scripts/build-tun-service.mjs --all",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:bridge": "node scripts/generate-tauri-bridge.mjs",
    "package:tauri": "npm run kernel:prepare && npm run tun-service:build && node scripts/tauri-package.mjs --all"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
