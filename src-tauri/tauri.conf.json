{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murge",
  "identifier": "io.murge.desktop",
  "mainBinaryName": "murge",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Murge",
        "width": 934,
        "height": 672,
        "minWidth": 848,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#eef3f8"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Murge Contributors",
    "copyright": "Copyright © 2026 Murge Contributors",
    "category": "Utility",
    "shortDescription": "A desktop network client powered by mihomo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/tray/*.png": "resources/tray/"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxM0MxOEYyN0U1QUREMUEKUldRYTNWcCs4aGc4c1VvUmNaR2VUSlNjUU9CNWdFVk9uTTlTVXk5a2ZjMjdRQm5VNVVLYVJ1aVMK",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
